      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"food_logs\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NULL, \"date\" TEXT NOT NULL, \"meal\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"grams\" REAL NULL, \"energy_kcal\" REAL NOT NULL, \"protein_g\" REAL NOT NULL DEFAULT 0.0, \"carb_g\" REAL NOT NULL DEFAULT 0.0, \"fat_g\" REAL NOT NULL DEFAULT 0.0, \"logged_via\" TEXT NOT NULL DEFAULT 'search', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },

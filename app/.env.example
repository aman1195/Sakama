# Copy to .env and fill in. NEVER commit .env (root .gitignore covers it).
# Values come from your Supabase project (Settings -> API) and PowerSync instance.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public client key: either the new sb_publishable_... key or a legacy anon key.
SUPABASE_ANON_KEY=YOUR-ANON-KEY
POWERSYNC_URL=https://YOUR-INSTANCE.powersync.journeyapps.com
